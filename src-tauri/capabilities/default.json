{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "identifier": "default",
  "description": "Default permissions for rs-alias-manager",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-create",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "opener:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bash",
          "command": "bash",
          "args": true,
          "sidecar": false
        },
        {
          "name": "zsh",
          "command": "zsh",
          "args": true,
          "sidecar": false
        },
        {
          "name": "fish",
          "command": "fish",
          "args": true,
          "sidecar": false
        }
      ]
    }
  ]
}
